{
  "name": "lyra",
  "version": "0.7.0",
  "private": true,
  "description": "Lyra, a local voice notebook: voice notes and meeting transcripts, all on device.",
  "main": "./out/main/index.js",
  "author": "Lyra contributors",
  "license": "MIT",
  "homepage": "https://github.com/osbytes/lyra",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm check && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "postinstall": "node scripts/fix-whisper-rpath.cjs",
    "smoke": "electron scripts/smoke-native.cjs",
    "smoke:ui": "electron-vite build && node scripts/run-ui-smoke.cjs",
    "smoke:meeting": "electron-vite build && node scripts/run-meeting-smoke.cjs",
    "eval:calls": "node scripts/run-eval.cjs --dataset calls",
    "eval:sessions": "node scripts/run-eval.cjs --dataset sessions",
    "eval:ami": "node scripts/run-eval.cjs --dataset ami",
    "eval:voxconverse": "node scripts/run-eval.cjs --dataset voxconverse",
    "eval:zoom": "node scripts/run-eval.cjs --dataset zoom",
    "eval:local": "node scripts/run-eval.cjs --dataset local",
    "replay:session": "node scripts/replay-session.cjs",
    "screenshot": "electron-vite build && node scripts/capture-screenshot.cjs",
    "build:unpack": "pnpm build && pnpm prepare:llama && electron-builder --dir --publish never",
    "build:win": "pnpm build && pnpm prepare:llama && electron-builder --win --publish never",
    "build:mac": "pnpm build && pnpm prepare:llama && pnpm build:mac-helpers && electron-builder --mac --publish never",
    "build:mac-helpers": "node scripts/build-mac-helpers.cjs",
    "build:linux": "pnpm build && pnpm prepare:llama && electron-builder --linux --publish never",
    "prepare:llama": "node scripts/prepare-llama.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "word-lists": "node scripts/update-word-lists.cjs",
    "config:docs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/config-docs.mjs",
    "config:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/config-docs.mjs --check",
    "check": "pnpm typecheck && pnpm lint && pnpm config:check && pnpm test",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/google": "^4.0.125",
    "@ai-sdk/openai": "^4.0.122",
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@electron-toolkit/utils": "^4.0.0",
    "@kutalia/whisper-node-addon": "^1.1.0",
    "@libsql/client": "^0.18.0",
    "ai": "^7.0.181",
    "electron-updater": "^6.8.9",
    "fuse.js": "^7.5.0",
    "onnxruntime-node": "1.31.1",
    "react-hotkeys-hook": "^5.4.0",
    "sherpa-onnx-node": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/markdown": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "42.11.18",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "node-llama-cpp": "3.22.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
