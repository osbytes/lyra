{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "check": {},
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**"
      ]
    },
    "smoke": {
      "cache": false
    },
    "smoke:ui": {
      "cache": false
    }
  }
}
